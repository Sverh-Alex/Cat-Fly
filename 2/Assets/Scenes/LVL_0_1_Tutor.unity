  text: 
  ru: "\u0443\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0441\u044F \u0438\u043B\u0438
    \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0439 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u044F\n(\u043E\u043D\u0438
    \u0440\u0430\u0437\u043D\u044B\u0435 \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u044F\u0445)"
  en: 'dodge or break obstacles

    (they are different at levels)'
  tr: "engelleri atlat\u0131n veya engelleri a\u015F\u0131n\n(d\xFCzeyleri farkl\u0131d\u0131r)"
  az: 
  be: 
  he: 
  hy: 
  ka: 
  et: 
  fr: "\xE9viter ou briser les obstacles\n(ils sont diff\xE9rents \xE0 niveaux)"
  kk: 
  ky: 
  lt: 
  lv: 
  ro: 
  tg: 
  tk: 
  uk: 
  uz: 
  es: "esquivar o romper obst\xE1culos\n(son diferentes en niveles)"
  pt: "desviar ou quebrar obst\xE1culos\n(eles s\xE3o diferentes em n\xEDveis)"
  ar: 
  id: 
  ja: 
  it: 
  de: 'Hindernissen ausweichen oder sie durchbrechen

    (sie unterscheiden sich
    auf den Ebenen)'
