    m_Metadata:
      m_Items: []
  - m_Id: 72841827672121344
    m_Localized: "TER ESPERAN\xC7A"
    m_Metadata:
      m_Items: []
  - m_Id: 84446413780410368
    m_Localized: "evite obst\xE1culos"
    m_Metadata:
      m_Items: []
  - m_Id: 84446560979509248
    m_Localized: "PEIXE para prote\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 84446724402176000
    m_Localized: Colete moedas
    m_Metadata:
      m_Items: []
  - m_Id: 84446695138516992
    m_Localized: colete moedas e liberte os gatos
    m_Metadata:
      m_Items: []
  - m_Id: 117412209167278080
    m_Localized: "pegar peixes e quebrar obst\xE1culos"
    m_Metadata:
      m_Items: []
  - m_Id: 117412487841030144
    m_Localized: "desviar ou quebrar obst\xE1culos\n(eles s\xE3o diferentes em n\xEDveis)"
    m_Metadata:
      m_Items: []
  - m_Id: 117412783979864064
    m_Localized: "Estou com medo e sozinho, me ajude a encontrar uma fam\xEDlia gentil
