    m_Metadata:
      m_Items: []
  - m_Id: 3247200619454464
    m_Localized: "GR\xC1TIS TUDO"
    m_Metadata:
      m_Items: []
  - m_Id: 45277871348150272
    m_Localized: "\u0420\u0423\u0421\u0421\u041A\u0418\u0419"
    m_Metadata:
      m_Items: []
  - m_Id: 1854219455143936
    m_Localized: GATINHOS
    m_Metadata:
      m_Items: []
  - m_Id: 628578689024
    m_Localized: Pular
    m_Metadata:
      m_Items: []
  - m_Id: 35824147094151168
    m_Localized: "USE BOT\xD5ES DE MOVIMENTO"
    m_Metadata:
      m_Items: []
  - m_Id: 45299915364265984
    m_Localized: "Se voc\xEA encontrar algum problema ou apenas quiser compartilhar
      suas emo\xE7\xF5es, escreva para n\xF3s!"
    m_Metadata:
      m_Items: []
  - m_Id: 71060005434941440
    m_Localized: "USE O BOT\xC3O PARA PROTE\xC7\xC3O"
    m_Metadata:
      m_Items: []
  - m_Id: 71061418038779904
    m_Localized: "SOMENTE \nN\xC3O ME DEIXE..."
    m_Metadata:
      m_Items: []
  - m_Id: 1876930994741248
    m_Localized: DE NOVO
    m_Metadata:
      m_Items: []
  - m_Id: 71062973664190464
    m_Localized: "N\xD3S PODEMOS FAZER ISSO!"
    m_Metadata:
      m_Items: []
  - m_Id: 35847441528758272
    m_Localized: "ESPA\xC7O"
    m_Metadata:
      m_Items: []
  - m_Id: 1876335655231488
    m_Localized: "\xD3TIMO"
    m_Metadata:
      m_Items: []
  - m_Id: 3261445675409408
    m_Localized: SEM SORTE
    m_Metadata:
      m_Items: []
  - m_Id: 71064575770877952
    m_Localized: Digite o texto...
    m_Metadata:
      m_Items: []
  - m_Id: 71064930374115328
    m_Localized: CONTINUAR
    m_Metadata:
      m_Items: []
  - m_Id: 35847067510087680
    m_Localized: "E \u201CESPA\xC7O\u201D PARA PROTE\xC7\xC3O"
    m_Metadata:
      m_Items: []
